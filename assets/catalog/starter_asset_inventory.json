  "art_direction": {
    "id": "enchanted_hand_painted_2_5d",
    "name": "Enchanted Hand-Painted 2.5D",
    "rendering_appearance": "painterly_stylized_realism",
    "status": "working_direction_established_calibration_pending",
    "description": "Rich hand-crafted fantasy artwork with controlled hand-painted surfaces, organic forms, weathered materials, dimensional lighting and an enchanted, cozy, mysterious atmosphere.",
    "characteristics": [
      "controlled hand-painted surface textures; intentionally rendered, not brushy",
      "softly defined contours without heavy black outlines",
      "dimensional shading and restrained ambient occlusion",
      "natural, weathered and clearly differentiated materials",
      "rich but mobile-readable detail hierarchy",
      "coherent 2.5D perspective and believable ground contact",
      "selective magical illumination and world-specific atmosphere"
    ],
    "exclusions": [
      "generic toy-like casual town-builder appearance",
      "heavy black outlines or flat vector fills",
      "uncontrolled visible brush strokes, muddy smears or painterly noise",
      "photorealism or default pixel-art rendering",
      "modern factories, industrial production buildings or conventional suburban architecture",
      "indiscriminate glow on ordinary objects",
      "micro-detail that collapses at mobile scale"
    ],
    "production_approval": "pending_cross_category_calibration"
  },
  "generation_pipeline": {
    "type": "2d_image_generation_only",
    "platform": {
      "name": "ComfyUI",
      "status": "proposed_local_platform"
    },
    "model_family": {
      "name": "Qwen Image",
      "status": "leading_candidate_not_finally_selected",
      "exact_release": "select_after_local_comfyui_compatibility_and_quality_test"
    },
    "gpu": {
      "model": "NVIDIA GeForce RTX 4090",
      "vram_gb": 24,
      "source": "user_reported_desktop_gpu"
    },
    "quantization": {
      "preferred_format": "GGUF_where_supported",
      "initial_candidate": "Q6_K",
      "comparison_candidate": "Q5_variant",
      "status": "benchmark_required"
    },
    "controlnet": {
      "status": "optional_not_required_for_standard_asset_generation",
      "policy": "Use only if a tested workflow provides clear value; do not require the user to create depth, silhouette, normal or line-art maps."
    },
    "transparency": {
      "status": "separate_compatibility_test",
      "layer_diffusion": "not_assumed_compatible_with_selected_qwen_workflow",
      "policy": "Verify genuine alpha or use a separate tested matting/extraction workflow."
    },
    "lora": {
      "status": "later_option",
      "policy": "Consider a Pocket Worlds style LoRA only after a coherent approved reference dataset exists."
    },
    "production_constraints": [
      "No Blender or 3D modelling.",
      "No manual authoring of depth, silhouette, normal or line-art maps.",
      "Start from prompts and approved image references.",
      "Preserve original generated sources and reusable workflow settings.",
      "Do not lock checkpoint, quantization, ControlNet or transparency nodes before local testing."
    ]
  },
